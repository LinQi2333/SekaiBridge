# ---- 运行环境 ----
NODE_ENV=production

# ---- 数据库 ----
DATABASE_PATH=./data/app.db

# ---- 媒体缓存 ----
CACHE_ROOT=./cache

# ---- TweetToaster ----
TWEETTOASTER_URL=http://tweettoaster:8082

# ---- Twitter 监听 ----
TWITTER_POLL_INTERVAL=60
SOURCE_CHECK_INTERVAL=1800
BOOTSTRAP_MODE=latest_only

# ---- QQ / OneBot ----
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# 允许接收消息的 QQ 群，逗号分隔
QQ_GROUP_IDS=
# 管理员 QQ 号，逗号分隔
QQ_ADMIN_IDS=

# ---- Bilibili ----
# secrets 只允许出现在 .env，禁止进入 Git / 源码 / 日志
BILI_SESSDATA=
BILI_JCT=
BILI_DEDEUSERID=

# ---- 发布 ----
PUBLISH_MODE=manual
