# ---- 运行环境 ----
NODE_ENV=production

# ---- 数据库 ----
DATABASE_PATH=./data/app.db

# ---- 媒体缓存 ----
CACHE_ROOT=./cache

# ---- TweetToaster ----
TWEETTOASTER_URL=http://tweettoaster:8082

# ---- Twitter 监听 ----
TWITTER_POLL_INTERVAL=60
SOURCE_CHECK_INTERVAL=1800
BOOTSTRAP_MODE=latest_only

# ---- QQ / OneBot ----
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# 允许接收消息的 QQ 群，逗号分隔
QQ_GROUP_IDS=
# 管理员 QQ 号，逗号分隔
QQ_ADMIN_IDS=

# ---- Bilibili ----
# secrets 只允许出现在 .env，禁止进入 Git / 源码 / 日志
BILI_SESSDATA=
BILI_JCT=
BILI_DEDEUSERID=
# 可选：浏览器登录 bilibili.com 后复制的完整 Cookie 串（DevTools → Application → Cookies，
# 逐条复制为 "name=value; name2=value2" 形式），含 buvid3/buvid4/b_lsid 等指纹，
# 配置后优先使用，请求形态最接近真实浏览器、降低风控概率；留空则回退到上面三项
BILI_COOKIE_STRING=
# 可选：持久化刷新口令（浏览器 F12 → Application → Local Storage → https://www.bilibili.com
# 的 ac_time_value 字段）。配置后 SESSDATA 临近过期会自动续期，无需再手工换 cookie
BILI_REFRESH_TOKEN=
# 可选：cookie 持久化文件（bili_ticket / SESSDATA 自动续期写回；默认在数据库同目录 bili-cookies.json）
BILI_COOKIE_FILE=

# ---- 发布 ----
PUBLISH_MODE=manual

# ---- 媒体缓存（!媒体 指令 / 发布 / 新推文自动下载）----
# FxTwitter API 根地址（取原图与最高码率视频地址；推特图片另走 TweetToaster 代理）
FX_TWITTER_BASE_URL=https://api.fxtwitter.com/2
# 单个媒体文件下载上限（MB）
MEDIA_EXPORT_MAX_MB=300
# QQ 群文件上限（MB）：超过该大小的媒体不上传，改为提示
MAX_GROUP_FILE_MB=100
# 媒体缓存保留天数：超期由后台每 6 小时清理一次（推文截图永久保留）
MEDIA_CACHE_TTL_DAYS=7

# ---- 可选：HTTP 代理 ----
# 国内服务器访问 Twitter 图床（pbs.twimg.com）被墙时配置，主程序与 TweetToaster 同时生效
# 例：HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=

# ---- 内部 HTTP API（NoneBot2 / 未来 Web 调用） ----
API_PORT=18080
# 共享 token，NoneBot2 调用时放在 X-API-Token 请求头；留空表示不校验
API_TOKEN=
