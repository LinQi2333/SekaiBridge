# ---- 运行环境 ----
NODE_ENV=production

# ---- 数据库 ----
DATABASE_PATH=./data/app.db

# ---- 媒体缓存 ----
CACHE_ROOT=./cache

# ---- TweetToaster ----
TWEETTOASTER_URL=http://tweettoaster:8082

# ---- Twitter 监听 ----
TWITTER_POLL_INTERVAL=60
SOURCE_CHECK_INTERVAL=1800
BOOTSTRAP_MODE=latest_only

# ---- QQ / OneBot ----
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# 允许接收消息的 QQ 群，逗号分隔
QQ_GROUP_IDS=
# 管理员 QQ 号，逗号分隔
QQ_ADMIN_IDS=

# ---- Bilibili ----
# 发布账号凭据由「扫码登录工具」写入 cookie 文件，不需要在这里配置：
#   docker compose stop app
#   docker compose --profile tools run --rm --build --service-ports bili-login
#   docker compose up -d app
# 下面两项是手工兜底（**推荐留空**）。注意 cookie 文件优先，
# 所以填写后必须删掉文件才生效：docker compose exec app rm -f /app/data/bili-cookies.json
BILI_COOKIE_STRING=
BILI_REFRESH_TOKEN=
# 旧版三件套：已不推荐（尤其 BILI_JCT 会与 cookie 文件里的 bili_jct 冲突导致 -111），保持留空
BILI_SESSDATA=
BILI_JCT=
BILI_DEDEUSERID=
# 可选：cookie 持久化文件路径（默认 /app/data/bili-cookies.json，与数据库同卷）
BILI_COOKIE_FILE=

# ---- 发布 ----
PUBLISH_MODE=manual

# ---- 媒体缓存（!媒体 指令 / 发布 / 新推文自动下载）----
# FxTwitter API 根地址（取原图与最高码率视频地址；推特图片另走 TweetToaster 代理）
FX_TWITTER_BASE_URL=https://api.fxtwitter.com/2
# 单个媒体文件下载上限（MB）
MEDIA_EXPORT_MAX_MB=300
# QQ 群文件上限（MB）：超过该大小的媒体不上传，改为提示
MAX_GROUP_FILE_MB=100
# 媒体缓存保留天数：超期由后台每 6 小时清理一次（推文截图永久保留）
MEDIA_CACHE_TTL_DAYS=7

# ---- 可选：HTTP 代理 ----
# 国内服务器访问 Twitter 图床（pbs.twimg.com）被墙时配置，主程序与 TweetToaster 同时生效
# 例：HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=

# ---- 内部 HTTP API（NoneBot2 / 未来 Web 调用） ----
API_PORT=18080
# 共享 token，NoneBot2 调用时放在 X-API-Token 请求头；留空表示不校验
API_TOKEN=
