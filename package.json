{
  "name": "sekai-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "SekaiBridge（世界桥）：PJSK 推文搬运——Twitter/X → QQ 翻译协作 → Bilibili 动态发布",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "twitter",
    "qq",
    "bilibili",
    "onebot",
    "translation"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
